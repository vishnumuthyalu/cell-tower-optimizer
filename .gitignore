# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Environment / secrets
.env

# Data — raw downloads are large and/or license-restricted; processed
# outputs are regenerated by the pipeline, not tracked
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

